@article{ning2025autonomous,
  author           = {Ning, Huan and Li, Zhenlong and Akinboyewa, Temitope and Lessani, M. Naser},
  title            = {{An autonomous GIS agent framework for geospatial data retrieval}},
  journaltitle     = {International Journal of Digital Earth},
