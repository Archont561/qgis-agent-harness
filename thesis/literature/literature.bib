@inproceedings{nargund2025mcp,
  author           = {Nargund, Nisharg and Swain, Anil Kumar and Behera, Naliniprava},
  title            = {{Model Context Protocol (MCP): A Lightweight, Modular Framework for Tool-Augmented LLM Agents}},
