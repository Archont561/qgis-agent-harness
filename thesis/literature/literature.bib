@online{mastouri2025automcp,
  author           = {Mastouri, Meriem and Ksontini, Emna and Barrak, Amine and Kessentini, Wael},
  title            = {{From REST to MCP: An Empirical Study of API Wrapping and Automated Server Generation for LLM Agents}},
  year             = {2025},
