@article{yu2026geoagentbench,
  author           = {Yu, Bo and Yang, Cheng and Hou, Dongyang and Liu, Chengfu and Liu, Jiayao and Wang, Chi and Zhang, Zhiming and Li, Haifeng and Yang, Wentao},
  title            = {{GeoAgentbench: a dynamic execution benchmark for tool-augmented agents in spatial analysis}},
  journaltitle     = {Geo-spatial Information Science},
  year             = {2026},
  pages            = {1-22},
  publisher        = {Informa UK Limited},
  issn             = {1009-5020},
  doi              = {10.1080/10095020.2026.2736957},
  url              = {https://doi.org/10.1080/10095020.2026.2736957},
  urldate          = {2026-10-31},
  abstract         = {The integration of large language models (LLMs) into geographic information systems (GIS) marks a paradigm shift toward autonomous spatial analysis. However, evaluating LLM-based agents remains challenging due to the complex, multi-step nature of geospatial workflows. Existing benchmarks primarily rely on static text or code matching, neglecting dynamic runtime feedback and the multimodal nature of spatial outputs. To address this gap, we introduce GeoAgentBench (GABench), a dynamic and interactive evaluation benchmark tailored for tool-augmented GIS agents. GABench provides a realistic execution sandbox integrating 133 atomic GIS tools and encompasses 57 representative spatial analysis tasks across six core GIS domains. Recognizing that precise parameter configuration is a key determinant of execution success in dynamic GIS environments, we design the parameter execution accuracy (PEA) metric, which utilizes a last-attempt alignment strategy to quantify the fidelity of implicit parameter inference. Complementing this, a vision-language model (VLM)-based verification protocol is proposed to assess data and spatial accuracy and cartographic style adherence. To support diagnostic comparisons across reasoning strategies, we instantiate four representative agent baselines, including direct tool invocation, ReAct, Plan-and-Solve, and a hybrid Plan-and-React baseline that combines global workflow decomposition with stepwise reactive execution. Extensive experiments with seven representative LLMs show that GABench can reveal distinct capability boundaries in long-chain orchestration, parameter-level execution, multimodal map-product generation, and runtime error recovery. The results further indicate that the hybrid planning–reactive strategy provides a strong reference baseline under dynamic GIS execution, while also exposing persistent limitations of current LLM agents in complex spatial analysis. Overall, GABench establishes a reproducible benchmark for assessing and advancing tool-augmented agents in autonomous GeoAI. The source code and dataset are available at: https://github.com/GeoX-Lab/GABench.},
  keywords         = {GeoAIWorkbench; MCP; GIS; LLM agents},
  note             = {abstract provenance: openalex (reconstructed inverted index)},
}

