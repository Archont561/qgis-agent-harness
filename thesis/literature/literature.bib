@online{fan2025mcptoolbench,
  author           = {Fan, Shiqing and Ding, Xichen and Zhang, Liang and Mo, Linjian},
  title            = {{MCPToolBench++: A Large Scale AI Agent Model Context Protocol MCP Tool Use Benchmark}},
  year             = {2025},
  doi              = {10.48550/arxiv.2508.07575},
  eprint           = {2508.07575},
  eprinttype       = {arxiv},
  url              = {https://doi.org/10.48550/arxiv.2508.07575},
  urldate          = {2026-10-31},
  abstract         = {LLMs' capabilities are enhanced by using function calls to integrate various data sources or API results into the context window. Typical tools include search, web crawlers, maps, financial data, file systems, and browser usage, etc. Integrating these data sources or functions requires a standardized method. The Model Context Protocol (MCP) provides a standardized way to supply context to LLMs. However, the evaluation of LLMs and AI Agents' MCP tool use abilities suffer from several issues. First, there's a lack of comprehensive datasets or benchmarks to evaluate various MCP tools. Second, the diverse formats of response from MCP tool call execution further increase the difficulty of evaluation. Additionally, unlike existing tool-use benchmarks with high success rates in functions like programming and math functions, the success rate of real-world MCP tool is not guaranteed and varies across different MCP servers. Furthermore, the LLMs' context window also limits the number of available tools that can be called in a single run, because the textual descriptions of tool and the parameters have long token length for an LLM to process all at once. To help address the challenges of evaluating LLMs' performance on calling MCP tools, we propose MCPToolBench++, a large-scale, multi-domain AI Agent tool use benchmark. As of July 2025, this benchmark is build upon marketplace of over 4k MCP servers from more than 40 categories, collected from the MCP marketplaces and GitHub communities. The datasets consist of both single-step and multi-step tool calls across different categories. We evaluated SOTA LLMs with agentic abilities on this benchmark and reported the results.},
  keywords         = {GeoAIWorkbench; MCP; GIS; LLM agents},
  note             = {abstract provenance: openalex (reconstructed inverted index)},
}

% provenance [fan2026infofidelity]: record-source=crossref-title-match | retrieved=2026-10-31 | confidence=title-match-score=1.0 | abstract-source=openalex (reconstructed inverted index) | oa-status=green | license=cc-by
@inproceedings{fan2026infofidelity,
  author           = {Fan, Flint Xiaofeng and Tan, Cheston and Wattenhofer, Roger and Ong, Yew-Soon},
  title            = {{Information Fidelity in Tool-Using LLM Agents: A Martingale Analysis of the Model Context Protocol}},
  booktitle        = {Proceedings of the 25th International Conference on Autonomous Agents and Multiagent Systems},
  year             = {2026},
  publisher        = {International Foundation for Autonomous Agents and Multiagent Systems},
  doi              = {10.65109/gmhb4353},
  url              = {https://doi.org/10.65109/gmhb4353},
  urldate          = {2026-10-31},
  abstract         = {As LLM agents increasingly rely on external tools via the Model Context Protocol (MCP), a key reliability question is whether small early mistakes can snowball across multi-step tool chains. We show this snowballing is avoidable: under bounded, decaying influence between steps, cumulative semantic distortion grows at most linearly with high-probability deviations of order O(√T), so random errors do not amplify superlinearly with chain length. We operationalize distortion with a hybrid metric that combines weighted fact matching and embedding similarity, and we certify the bound via a Doob-martingale concentration argument. Experiments on different open-sourced LLM architectures match the predicted linear trend and √T envelopes, yielding practical design rules such as re-grounding intervals and semantic weighting.},
  keywords         = {GeoAIWorkbench; MCP; GIS; LLM agents},
  note             = {abstract provenance: openalex (reconstructed inverted index)},
}

% provenance [gis-mcp-server-cluster-2026]: record-source=kb-doi | retrieved=2026-10-31 | confidence=title-match-score=1.0 | abstract-source=openalex (reconstructed inverted index) | oa-status=bronze
@inproceedings{gis-mcp-server-cluster-2026,
  author           = {Liu, Su and Zheng, Weipeng and Xiao, Yufeng and Weng, Yamin and Yuan, Ying and Yu, Qipeng and Zeng, Zhiqiang},
  title            = {{MapHub: an OGC web GIS service aggregation and query MCP server for AI agents}},
  booktitle        = {International Conference on Mechanical, Engineering, and Interaction Design (ICMEID 2025)},
  year             = {2026},
  pages            = {363},
  publisher        = {SPIE},
  doi              = {10.1117/12.3091756},
  url              = {https://doi.org/10.1117/12.3091756},
  urldate          = {2026-10-31},
  abstract         = {Geographic Information Systems (GIS) are evolving from specialized tools into inclusive spatial intelligence infrastructure, yet non-professional users still face core challenges: inefficient geospatial data discovery and high barriers to complex spatial analysis. Traditional Web GIS platforms struggle to accurately match natural language intents (e.g., "Which states border the Mississippi River?") with distributed OGC services (WMS/WFS/WMTS) and execute relevant spatial queries. While Large Language Models (LLM) and Model Context Protocol (MCP) maturity provide the technical foundation for intelligent interaction, current GIS ecosystems lack a unified framework to integrate distributed OGC services and expose them for LLM agent invocation, resulting in a "semantic-spatial disconnect." To address this, we propose MapHub ， an OGC service aggregation and query MCP Server for AI Agents. This lightweight, cross-platform deployable MCP Server, built on FastMCP, enables dynamic registration, aggregation, and transformation of OGC services into MCP resources and tools, supporting plug-and-play integration of heterogeneous WMS/WFS/WMTS services. By closing the loop between intent understanding, resource discovery, and tool invocation, it constructs an intelligent layer scoring system to enhance accuracy in identifying primary layers during queries. Additionally, it designs a visualization pipeline using a declarative HTML generation framework, seamlessly interfacing with Leaflet to automate the conversion of query results into interactive maps. MapHub’s open-source implementation (https://github.com/YQP-2511/maphub-core) provides a reference for natural language-driven spatial intelligence applications, propelling Web GIS into the era of "conversation-as-map." Future work will extend WPS support for complex analyses and explore distributed architectures for million-layer scheduling.},
  keywords         = {GeoAIWorkbench; MCP; GIS; LLM agents},
  note             = {abstract provenance: openalex (reconstructed inverted index)},
}

