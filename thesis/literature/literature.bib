@article{liang2026geoagentic,
  author           = {Liang, Chao and Cui, Yuanzheng and Shi, Run and Zha, Guixiang and Yin, Xin and Xiao, Mingzhong and Xu, Dong and Duan, Xuejun and Huang, Bo},
  title            = {{GeoAgentic-RAG: A Multi-Agent framework for autonomous geospatial reasoning and visual insight generation with LLM}},
  journaltitle     = {International Journal of Applied Earth Observation and Geoinformation},
