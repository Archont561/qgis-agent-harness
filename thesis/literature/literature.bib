@article{wu2025geocolab,
  author           = {Wu, Huayi and Jiao, Haoyue and Hou, Shuyang and Liang, Jianyuan and Shen, Zhangxiao and Zhao, Anqi and Qing, Yaxian and Jin, Fengying and Guan, Xuefeng and Gui, Zhipeng},
  title            = {{GeoColab: an LLM-based multi-agent collaborative framework for geospatial code generation}},
