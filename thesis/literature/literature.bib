@online{shabbir2025thinkgeo,
  author           = {Shabbir, Akashah and Munir, Muhammad Akhtar and Dudhane, Akshay and Sheikh, Muhammad Umer and Khan, Muhammad Haris and Fraccaro, Paolo and Moreno, Juan Bernabe and Khan, Fahad Shahbaz and Khan, Salman},
  title            = {{ThinkGeo: Evaluating Tool-Augmented Agents for Remote Sensing Tasks}},
  year             = {2025},
