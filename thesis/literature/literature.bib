@article{ogsagent2026,
  author           = {Wang, Kaixuan and Yue, Peng and Wu, Haoru and Teng, Baoxin},
  title            = {{OGSAgent: an MCP-based multi-agent collaboration framework for intelligent GIServices}},
  journaltitle     = {International Journal of Geographical Information Science},
  year             = {2026},
