@article{luo2026geojson,
  author           = {Luo, Qianqian and Lin, Qingming and Xu, Liuchang and Wu, Sensen and Mao, Ruichen and Wang, Chao and Feng, Hailin and Huang, Bo and Du, Zhenhong},
  title            = {{GeoJSON agents: a multi-agent LLM architecture for geospatial analysis—function calling vs. code generation}},
  journaltitle     = {Big Earth Data},
