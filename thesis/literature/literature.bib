@inproceedings{mo2025livemcpbench,
  author           = {Mo, Guozhao and Zhong, Wenliang and Chen, Jiawei and Yuan, Qianhao and Chen, Xuanang and Lu, Yaojie and Lin, Hongyu and He, Ben and Han, Xianpei and Sun, Le},
  title            = {{LiveMCPBench: Can Agents Navigate an Ocean of MCP Tools?}},
  booktitle        = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
