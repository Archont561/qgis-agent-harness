@online{yin2025livemcp,
  author           = {Yin, Ming and Shen, Dinghan and Xu, Silei and Dong, Sixun and Zhang, Mian and Hu, Yebowen and Liu, Shujian and Han, Jianbing and Ma, Simin and Wang, Song and Indurthi, Sathish Reddy and Wang, Xun and Chen, Yiran and Song, Kaiqiang},
  title            = {{LiveMCP-101: Stress Testing and Diagnosing MCP-enabled Agents on Challenging Queries}},
